   "text": "M",
   "size": 0.22,
   "color": "good",
   "position": [
    "(${w})*((((${orient}))*(-(${p}))+(1-((${orient})))*((${xp})))-(${xmin}))/(${xmax}-${xmin})-(${w})/2+0.22",
    "(${h})*clamp(((((${orient}))*((${xp}))+(1-((${orient})))*(-(${p})))-(${ymin}))/(${ymax}-${ymin}),-0.05,1.05)-(${h})/2-0.22",
