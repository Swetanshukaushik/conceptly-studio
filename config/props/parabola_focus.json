    "(${h})*clamp(((((${orient}))*(0)+(1-((${orient})))*(${p}))-(${ymin}))/(${ymax}-${ymin}),-0.05,1.05)-(${h})/2+0.2",
    0
   ],
   "visible": "(t>=${t0})"
  },
  {
   "type": "curve",
   "points": [
    [
     "(${w})*((((${orient}))*((${xp}^2/(4*${p})))+(1-((${orient})))*((${xp})))-(${xmin}))/(${xmax}-${xmin})-(${w})/2",
     "(${h})*clamp(((((${orient}))*((${xp}))+(1-((${orient})))*((${xp}^2/(4*${p}))))-(${ymin}))/(${ymax}-${ymin}),-0.05,1.05)-(${h})/2",
     0
    ],
    [
     "(${w})*((((${orient}))*(${p})+(1-((${orient})))*(0))-(${xmin}))/(${xmax}-${xmin})-(${w})/2",
     "(${h})*clamp(((((${orient}))*(0)+(1-((${orient})))*(${p}))-(${ymin}))/(${ymax}-${ymin}),-0.05,1.05)-(${h})/2",
     0
    ]
   ],
   "color": "warn",
   "width": 4,
   "visible": "(t>=${t0})"
  },
  {
   "type": "curve",
   "points": [
    [
     "(${w})*((((${orient}))*((${xp}^2/(4*${p})))+(1-((${orient})))*((${xp})))-(${xmin}))/(${xmax}-${xmin})-(${w})/2",
     "(${h})*clamp(((((${orient}))*((${xp}))+(1-((${orient})))*((${xp}^2/(4*${p}))))-(${ymin}))/(${ymax}-${ymin}),-0.05,1.05)-(${h})/2",
     0
    ],
    [
     "(${w})*((((${orient}))*(-(${p}))+(1-((${orient})))*((${xp})))-(${xmin}))/(${xmax}-${xmin})-(${w})/2",
     "(${h})*clamp(((((${orient}))*((${xp}))+(1-((${orient})))*(-(${p})))-(${ymin}))/(${ymax}-${ymin}),-0.05,1.05)-(${h})/2",
     0
    ]
   ],
   "color": "good",
   "width": 4,
   "visible": "(t>=${t0})"
  },
  {
