   },
   "position": [
    "(${w})*((((${orient}))*((${xp}^2/(4*${p})))+(1-((${orient})))*((${xp})))-(${xmin}))/(${xmax}-${xmin})-(${w})/2",
    "(${h})*clamp(((((${orient}))*((${xp}))+(1-((${orient})))*((${xp}^2/(4*${p}))))-(${ymin}))/(${ymax}-${ymin}),-0.05,1.05)-(${h})/2",
    0
   ],
   "visible": "(t>=${t0})"
  },
  {
   "type": "label",
   "text": "P",
   "size": 0.24,
   "color": "accent",
   "position": [
    "(${w})*((((${orient}))*((${xp}^2/(4*${p})))+(1-((${orient})))*((${xp})))-(${xmin}))/(${xmax}-${xmin})-(${w})/2+0.25",
    "(${h})*clamp(((((${orient}))*((${xp}))+(1-((${orient})))*((${xp}^2/(4*${p}))))-(${ymin}))/(${ymax}-${ymin}),-0.05,1.05)-(${h})/2+0.2",
    0
   ],
   "visible": "(t>=${t0})"
  },
  {
