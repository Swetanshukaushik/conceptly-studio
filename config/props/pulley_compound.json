{
 "about": "Compound pulley system, as in classroom diagrams: one fixed pulley on the ceiling and one movable pulley carrying the load, with the rope anchored to the ceiling, under the movable pulley, over the fixed pulley and down to the effort handle. The effort handle is pulled down by `dist` while the load rises dist/2 (mechanical advantage 2). Ideal forces: effort = load/2. The system animates itself between `t0` and `t0+dur`. Origin is the ground under the movable pulley; the ceiling underside is at y=`yc`. Add a base_slab, ceiling_beam and workshop_wall around it.",
 "params_doc": {
  "loadText": "label on the weight, e.g. '100 kg'",
  "loadForce": "force label for the weight, e.g. '1000 N'",
  "effortForce": "force label for the pull, e.g. '500 N'",
  "t0": "scene time (s) when pulling starts",
  "dur": "seconds the pull lasts",
  "dist": "how far the handle is pulled (units) (limited automatically so the handle never goes below the ground)",
  "showForces": "1 = draw force arrows and labels",
  "forceAt": "scene time when force arrows appear",
  "wheel": "pulley colour"
 },
 "params": {
  "loadText": "100 kg",
  "loadForce": "1000 N",
  "effortForce": "500 N",
  "t0": 1.2,
