  "ym": "${ym0}+${pull}/2",
  "ye": "${ye0}-${pull}",
  "spinM": "((${pull}/2)/${rm})*57.3",
  "spinF": "-(${pull}/${rf})*57.3",
  "yb": "${ym}-${rm}-0.5-0.35"
 },
