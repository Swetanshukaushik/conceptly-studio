   "text": "${plabel}",
   "size": 0.2,
   "color": "warn",
   "position": [
    "(${w})*((${px})-(${xmin}))/(${xmax}-${xmin})-(${w})/2+0.55",
    "(${h})*clamp(((${py})-(${ymin}))/(${ymax}-${ymin}),-0.05,1.05)-(${h})/2+0.25",
    0
   ],
   "visible": "${ps}*(t>=${pt})"
  }
 ]
}