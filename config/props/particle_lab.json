{
 "about": "Gas-phase chemistry lab: a glass cylinder with a plunger and up to four kinds of coloured particles bouncing inside, plus a pressure gauge. The reaction a A + b B <=> c C + d D shifts according to the equilibrium constant when you change the volume (move the plunger), add or remove a species, or change the temperature, so the particle counts always obey Le Chatelier's principle: the numbers come from a solver, not from the director. Particle counts are shown at the equilibrium for the current volume. Also good for gas laws (Boyle: set one species, no reaction, volume only) and collision/kinetics ideas (speed). Set `vol` for the plunger (1 = full chamber, 0.4 = squeezed): an expression of t like 'mix(1,0.45,smooth(2,4,t))'. Species colours default to N2 blue, H2 white, NH3 red. The gauge stands left of the cylinder and the colour legend top right, so the lower right stays free for the narrator.",
 "params_doc": {
  "a": "stoichiometric number of A (reactant)",
  "b": "of B (reactant, 0 if absent)",
  "c": "of C (product)",
  "d": "of D (product, 0 if absent)",
  "nA": "particle count of A at the reference equilibrium (volume 1)",
  "nB": "of B",
  "nC": "of C",
  "nD": "of D",
  "vol": "plunger position / volume factor, expression of t (1 = full)",
  "dA": "particles of A added (negative = removed) as an expression of t, e.g. '12*smooth(3,3.5,t)'",
  "dB": "same for B",
  "dC": "same for C",
  "dD": "same for D",
  "Kt": "equilibrium constant as an expression of t; default is the constant K measured from the reference counts; for temperature changes use vanthoff(K, dH, T1, T2) with dH in kJ/mol (negative = exothermic) and T in kelvin",
  "spd": "particle clock: 't' for constant temperature, 't+0.6*smoothint(a,b,t)' to heat up between a and b seconds",
  "cA": "colour of A",
  "cB": "colour of B",
  "cC": "colour of C",
  "cD": "colour of D",
  "rA": "radius of A particles",
  "rB": "",
  "rC": "",
  "rD": "",
  "maxN": "most particles of one kind drawn (default 60)",
  "rc": "cylinder radius",
  "h0": "chamber height at vol 1",
  "gauge": "1 to show the pressure gauge",
  "lA": "formula shown in the legend for A, e.g. 'N2' (default is the formula of the default reaction)",
  "lB": "legend for B",
  "lC": "legend for C",
  "lD": "legend for D (empty = hidden)",
  "legend": "1 to show the colour legend"
 },
 "bounds": {
  "size": [
   4.2,
   3.9
  ],
  "center": [
   0.0,
   1.15
  ]
 },
 "params": {
