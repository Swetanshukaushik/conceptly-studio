  "b": 3,
  "c": 2,
  "d": 0,
  "nA": 8,
  "nB": 24,
  "nC": 16,
  "nD": 0,
  "vol": 1,
  "dA": 0,
  "dB": 0,
  "dC": 0,
  "dD": 0,
  "K": "Keq(${a},${b},${c},${d},${nA},${nB},${nC},${nD},1)",
  "Kt": "${K}",
  "spd": "t",
  "cA": "#2f6bff",
  "cB": "#6f7fa0",
  "cC": "#ff4d4d",
  "cD": "#ffb020",
  "rA": 0.1,
  "rB": 0.075,
  "rC": 0.11,
  "rD": 0.1,
  "maxN": 60,
  "rc": 1.0,
  "h0": 2.4,
