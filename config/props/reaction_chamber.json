{
 "about": "Glass chamber full of two kinds of moving particles (species A and B) that convert into each other: a dynamic equilibrium. The fraction of A relaxes from `fA0` to the equilibrium value kr/(kf+kr) after `t0`; a disturbance at `tS` (e.g. adding reactant) pushes it away and it relaxes back (Le Chatelier). Two arrows under the chamber show forward and reverse rates, which become equal at equilibrium. Pair it with concentration_graph using the SAME kf, kr, fA0, k, t0, tS, bump. Use plain ASCII for texts (no subscript characters); show chemical formulas in a LaTeX formula card. Origin at the centre of the chamber floor.",
 "params_doc": {
  "kf": "forward rate constant (A to B)",
  "kr": "reverse rate constant (B to A); equilibrium fraction of A = kr/(kf+kr)",
  "fA0": "starting fraction of species A (0..1)",
  "k": "how fast the system relaxes to equilibrium",
  "t0": "scene time (s) when the reaction starts",
  "tS": "scene time (s) of a disturbance (99 = none)",
  "bump": "how much the fraction of A jumps up at tS (adding reactant, Le Chatelier); negative removes it",
  "span": "graph time span in seconds (use the scene duration)",
  "nameA": "label for species A (ASCII, e.g. 'N2O4')",
  "nameB": "label for species B",
  "colA": "colour of A",
  "colB": "colour of B",
  "N": "number of particles (60-300)",
  "w": "chamber width",
  "h": "chamber height",
  "d": "chamber depth",
  "showRates": "1 = show the forward / reverse rate arrows"
 },
 "bounds": {
  "size": [
   3.0,
   3.0
  ],
  "center": [
   0,
   0.9
  ]
 },
 "params": {
  "kf": 0.8,
  "kr": 0.4,
  "fA0": 0.95,
  "k": 0.55,
  "t0": 0.6,
  "tS": 99,
  "bump": 0,
  "span": 8,
  "fAeq": "${kr}/(${kf}+${kr})",
  "fA1": "${fAeq}+(${fA0}-${fAeq})*exp(-${k}*max(0,t-${t0}))",
  "fAs": "${fAeq}+(${fA0}-${fAeq})*exp(-${k}*max(0,${tS}-${t0}))",
  "fA2": "${fAeq}+(min(1,${fAs}+${bump})-${fAeq})*exp(-${k}*(t-${tS}))",
  "fA": "if(t<${tS},${fA1},${fA2})",
  "N": 140,
  "w": 1.8,
  "h": 1.7,
  "d": 1.2,
  "pr": 0.05,
  "rs": 1.8,
  "colA": "#ff8a3d",
  "colB": "#2f6fe0",
  "nameA": "A",
  "nameB": "B",
  "showRates": 1
 },
