{
 "about": "Single fixed pulley on the ceiling: the load hangs on one rope end and the effort handle is pulled down on the other. Effort equals the load (no force saved, only direction changed). The handle moves down by `dist` and the load rises by the same distance. Origin is the ground under the pulley; ceiling underside at y=`yc`. Add a base_slab, ceiling_beam and workshop_wall.",
 "params_doc": {
  "loadText": "label on the weight",
  "loadForce": "force label for the weight",
  "effortForce": "force label for the pull",
  "t0": "scene time (s) when pulling starts",
  "dur": "seconds the pull lasts",
  "dist": "how far the handle is pulled (limited automatically so the handle never goes below the ground)",
  "showForces": "1 = draw force arrows and labels",
  "forceAt": "scene time when arrows appear",
  "wheel": "pulley colour"
 },
 "params": {
  "loadText": "100 kg",
  "loadForce": "1000 N",
  "effortForce": "1000 N",
  "t0": 1.2,
  "dur": 3.0,
  "dist": 1.4,
  "showForces": 1,
  "forceAt": 0.6,
  "wheel": "#4f86d6",
  "rf": 0.45,
  "cxf": 0,
  "yc": 4.2,
  "yf": 3.4,
  "yl0": 1.35,
  "ye0": 1.9,
  "p": "smooth(${t0},${t0}+${dur},t)",
  "pull": "min(${dist},${ye0}-0.25)*${p}",
  "yl": "${yl0}+${pull}",
  "ye": "${ye0}-${pull}",
  "spinF": "-(${pull}/${rf})*57.3",
  "yb": "${yl}-0.35-0.12"
 },
