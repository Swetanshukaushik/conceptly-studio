{
 "about": "Atom model: glowing nucleus and electrons travelling on tilted orbits. Good for chemistry and electricity.",
 "params_doc": {
  "electrons": "1-8",
  "radius": "orbit radius",
  "nucleus": "nucleus colour",
  "electron": "electron colour",
  "speed": "orbit speed"
 },
 "params": {
  "electrons": 3,
  "radius": 0.9,
  "nucleus": "accent",
  "electron": "primary",
  "speed": 1
 },
 "objects": [
  {
   "type": "sphere",
   "radius": 0.22,
   "material": {
    "color": "${nucleus}",
    "emissive": "${nucleus}",
    "emissiveIntensity": 0.9,
    "roughness": 0.4
   }
  },
  {
   "type": "glow",
   "color": "${nucleus}",
   "size": 1.2,
   "intensity": 0.5
  },
  {
   "repeat": "${electrons}",
   "type": "group",
   "rotation": [
    "60*${i}",
    0,
    "35*${i}"
   ],
   "children": [
    {
     "type": "torus",
     "radius": "${radius}",
     "tube": 0.008,
     "material": {
      "color": "${electron}",
      "emissive": "${electron}",
      "emissiveIntensity": 0.8,
      "opacity": 0.5
     },
     "rotation": [
      90,
      0,
      0
     ]
    },
    {
     "type": "sphere",
     "radius": 0.07,
     "material": {
      "color": "${electron}",
      "emissive": "${electron}",
      "emissiveIntensity": 1.4,
      "roughness": 0.3
     },
     "position": [
      "${radius}*cos(${speed}*(2.2*t+${i}*2.1))",
      0,
      "${radius}*sin(${speed}*(2.2*t+${i}*2.1))"
     ]
    }
   ]
  }
 ]
}