{
 "about": "Axes with up to three curves plotted from expressions of X (the horizontal quantity), drawn progressively while the scene plays. Use it for v-t, x-t, a-t, energy-time, P-V, I-V or any graph. For graphs of a motion simulation use time as X and sim() in the expressions, e.g. y1 'sim(3,0,X)' (vertical velocity of body 0). Set ymin and ymax to cover the data. `now` is the X value reached so far (default ts, the simulated time). Origin at the lower-left corner of the axes.",
 "params_doc": {
  "w": "graph width",
  "h": "graph height",
  "xmin": "X at the left",
  "xmax": "X at the right",
  "ymin": "value at the bottom",
  "ymax": "value at the top",
  "y1": "expression of X for curve 1",
  "y2": "curve 2",
  "y3": "curve 3",
  "s1": "1 to show curve 1",
  "s2": "1 to show curve 2",
  "s3": "1 to show curve 3",
  "c1": "colour of curve 1",
  "c2": "colour 2",
  "c3": "colour 3",
  "n1": "label of curve 1 (ASCII)",
  "n2": "label 2",
  "n3": "label 3",
  "xlabel": "horizontal axis label (ASCII)",
  "ylabel": "vertical axis label",
  "xmaxText": "text at the right end of the axis, e.g. '4 s'",
  "ymaxText": "text at the top of the axis, e.g. '10 m/s'",
  "now": "expression for how far the curve has been drawn in X units (default ts)",
  "cursor": "1 = moving dots at the current X"
 },
 "bounds": {
  "size": [
   3.2,
   2.2
  ],
  "center": [
   1.3,
   0.9
  ]
 },
 "params": {
  "w": 2.4,
  "h": 1.6,
  "xmin": 0,
  "xmax": 4,
  "ymin": 0,
  "ymax": 10,
  "y1": "X",
  "y2": "0",
  "y3": "0",
  "s1": 1,
  "s2": 0,
  "s3": 0,
  "c1": "#ffc23d",
  "c2": "#5aa9ff",
  "c3": "#3ddc97",
  "n1": "",
  "n2": "",
  "n3": "",
  "xlabel": "t (s)",
  "ylabel": "",
  "xmaxText": "4",
  "ymaxText": "10",
  "now": "ts",
  "cursor": 1
 },
 "objects": [
  {
   "type": "box",
   "size": [
    "${w}",
    0.03,
    0.03
   ],
   "material": {
    "color": "muted",
    "roughness": 0.4
   },
   "position": [
    "${w}/2",
    0,
    0
   ]
  },
  {
   "type": "box",
   "size": [
    0.03,
    "${h}",
    0.03
   ],
   "material": {
    "color": "muted",
    "roughness": 0.4
   },
   "position": [
    0,
    "${h}/2",
    0
   ]
  },
  {
   "type": "label",
   "text": "${xlabel}",
   "size": 0.14,
   "color": "muted",
   "position": [
    "${w}/2",
    -0.22,
    0
   ]
  },
  {
   "type": "label",
   "text": "${ylabel}",
   "size": 0.14,
   "color": "muted",
   "position": [
    0.3,
    "${h}+0.2",
    0
   ]
  },
  {
   "type": "label",
   "text": "${xmaxText}",
   "size": 0.12,
   "color": "muted",
   "position": [
    "${w}",
    -0.2,
    0
   ]
  },
  {
   "type": "label",
   "text": "${ymaxText}",
   "size": 0.12,
   "color": "muted",
   "position": [
    -0.28,
    "${h}",
    0
   ]
  },
  {
   "type": "label",
   "text": "0",
   "size": 0.12,
   "color": "muted",
   "position": [
    -0.15,
    -0.15,
    0
   ]
  },
  {
   "type": "curve",
   "plot": {
    "x": [
     "${xmin}",
     "${xmax}"
    ],
    "y": [
     "${ymin}",
     "${ymax}"
    ],
    "w": "${w}",
    "h": "${h}"
   },
   "var": "X",
   "y": "${y1}",
   "samples": 160,
   "color": "${c1}",
   "width": 6,
   "draw": "clamp((${now}-${xmin})/(${xmax}-${xmin}),0,1)",
   "visible": "${s1}"
  },
  {
   "type": "sphere",
   "radius": 0.05,
   "material": {
    "color": "${c1}",
    "emissive": "${c1}",
    "emissiveIntensity": 1.0,
    "roughness": 0.4
   },
   "position": [
    "${w}*clamp((${now}-${xmin})/(${xmax}-${xmin}),0,1)",
    "${h}*clamp(((${y1})-(${ymin}))/(${ymax}-${ymin}),0,1)",
    0
   ],
   "visible": "${s1}*${cursor}",
   "vars": {
    "X": "${now}"
   }
  },
  {
   "type": "label",
   "text": "${n1}",
   "size": 0.14,
   "color": "${c1}",
   "position": [
    "${w}+0.25",
    "${h}*(1-1*0.16)",
    0
   ],
   "visible": "${s1}"
  },
  {
   "type": "curve",
   "plot": {
    "x": [
     "${xmin}",
     "${xmax}"
    ],
    "y": [
     "${ymin}",
     "${ymax}"
    ],
    "w": "${w}",
    "h": "${h}"
   },
   "var": "X",
   "y": "${y2}",
   "samples": 160,
   "color": "${c2}",
   "width": 6,
   "draw": "clamp((${now}-${xmin})/(${xmax}-${xmin}),0,1)",
   "visible": "${s2}"
  },
  {
   "type": "sphere",
   "radius": 0.05,
   "material": {
    "color": "${c2}",
    "emissive": "${c2}",
    "emissiveIntensity": 1.0,
    "roughness": 0.4
   },
   "position": [
    "${w}*clamp((${now}-${xmin})/(${xmax}-${xmin}),0,1)",
    "${h}*clamp(((${y2})-(${ymin}))/(${ymax}-${ymin}),0,1)",
    0
   ],
   "visible": "${s2}*${cursor}",
   "vars": {
    "X": "${now}"
   }
  },
  {
   "type": "label",
   "text": "${n2}",
   "size": 0.14,
   "color": "${c2}",
   "position": [
    "${w}+0.25",
    "${h}*(1-2*0.16)",
    0
   ],
   "visible": "${s2}"
  },
  {
   "type": "curve",
   "plot": {
    "x": [
     "${xmin}",
     "${xmax}"
    ],
    "y": [
     "${ymin}",
     "${ymax}"
    ],
    "w": "${w}",
    "h": "${h}"
   },
   "var": "X",
   "y": "${y3}",
   "samples": 160,
   "color": "${c3}",
   "width": 6,
   "draw": "clamp((${now}-${xmin})/(${xmax}-${xmin}),0,1)",
   "visible": "${s3}"
  },
  {
   "type": "sphere",
   "radius": 0.05,
   "material": {
    "color": "${c3}",
    "emissive": "${c3}",
    "emissiveIntensity": 1.0,
    "roughness": 0.4
   },
   "position": [
    "${w}*clamp((${now}-${xmin})/(${xmax}-${xmin}),0,1)",
    "${h}*clamp(((${y3})-(${ymin}))/(${ymax}-${ymin}),0,1)",
    0
   ],
   "visible": "${s3}*${cursor}",
   "vars": {
    "X": "${now}"
   }
  },
  {
   "type": "label",
   "text": "${n3}",
   "size": 0.14,
   "color": "${c3}",
   "position": [
    "${w}+0.25",
    "${h}*(1-3*0.16)",
    0
   ],
   "visible": "${s3}"
  }
 ]
}