   "material": {
    "color": "${leaf}",
    "roughness": 0.85,
    "metalness": 0
   },
   "position": [
    0,
    "${height}*0.78",
    0
   ]
  },
  {
   "type": "cone",
   "radius": "${height}*0.15",
   "height": "${height}*0.32",
