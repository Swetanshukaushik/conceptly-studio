{
 "about": "A stylised tree: trunk and layered foliage. Seen from any side.",
 "params_doc": {
  "height": "tree height",
  "leaf": "foliage colour",
  "trunk": "trunk colour"
 },
 "params": {
  "height": 2.4,
  "leaf": "#3e8a4a",
  "trunk": "#6b4a2f"
 },
 "objects": [
  {
   "type": "cylinder",
