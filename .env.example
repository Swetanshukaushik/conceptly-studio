# Conceptly API Integration
CONCEPTLY_API_BASE_URL=https://conceptly-api.onrender.com/v1
CONCEPTLY_API_KEY=

# LLM Providers for Scripting & Research
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Voice / TTS Providers
ELEVENLABS_API_KEY=
