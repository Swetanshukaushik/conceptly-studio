# Cloud Media Storage (Cloudflare R2 or AWS S3)
STORAGE_PROVIDER=local # Options: local, r2, s3
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=conceptly-reels
R2_PUBLIC_URL=https://media.conceptly.app
